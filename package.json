  ],
  "type": "module",
  "devDependencies": {
    "@happy-dom/global-registrator": "^18.0.1",
    "@tailwindcss/cli": "4.1.4",
    "@tailwindcss/postcss": "4.1.4",
    "@types/bun": "latest",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/terminal-kit": "^2.5.7",
    "@types/web": "^0.0.216",
  "typescript": "^5.8.3",
    "tailwind-bunext-plugin": "0.1.0",
    "tailwindcss": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@base2/pretty-print-object": "1.0.2",
    "@bunpmjs/json-webtoken": "0.1.0",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@svgr/plugin-svgo": "8.1.0",
    "bun-types": "latest",
    "is-plain-object": "5.0.0",
    "json-beautify": "1.1.1",
    "next-json": "0.3.2",
    "react-is": "19.1.1",
    "sharp": "^0.34.3",
    "terminal-kit": "^3.1.2"
  },
  "bin": {
    "bunext": "bin/index.ts"
  },
  "scripts": {
    "test": "bun run build && bun test ./bin/main.test.ts",
    "clear": "rm -rf .bunext/build/* .bunext/build/.bunext config/bunext.* config/session.*",
    "dev": "bun --hot .bunext/react-ssr/server.ts dev",
    "start": "bun .bunext/react-ssr/server.ts production",
    "build": "bun ./bin/index.ts build",
    "db:create": "bun ./bin/index.ts database:create",
    "bunext": "bun ./bin/index.ts"
  },
  "keywords": [
    "react",
    "framework",
    "full-stack",
    "front-end",
    "backend",
    "web",
    "server",
    "bun"
  ],
  "exports": {
  "./types": "./public/types.ts",
  "./database": "./public/database/index.ts",
  "./database/schema": "./public/database/schema.ts",
  "./database/types": "./public/database/types.ts",
  "./database/class": "./public/database/class.ts",
  "./session": "./public/session/index.ts",
  "./router/navigate": "./public/router/navigate.ts",
  "./router/revalidate": "./public/router/revalidate.ts",
  "./router/components": "./public/router/components.tsx",
  "./router/hooks": "./public/router/hooks.ts",
  "./router/link": "./public/router/link.ts",
  "./head": "./public/head.tsx",
  "./image": "./public/image/index.tsx",
  "./link": "./public/link.ts",
  "./request": "./public/request/index.ts",
  "./request/types": "./public/request/types.ts",
  "./request/hooks": "./public/request/hooks.ts",
  "./utils": "./public/utils/index.ts",
  "./utils/types": "./public/utils/types.ts",
  "./plugins/types": "./public/plugins/types.ts",
  "./router/*": "./public/router/*",
  "./client/hydrate": "./public/client/hydrate.ts",
  "./client/globals": "./public/client/globals.ts",
  "./client/*": "./public/client/*",
  "./plugins/*": "./plugins/*",
  "./dev": "./public/dev/index.tsx",
  "./server/bunext-server": "./public/server/bunext-server.ts",
  "./client/shell": "./public/client/shell.ts"
  }
}
